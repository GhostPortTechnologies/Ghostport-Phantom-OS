flush ruleset
include "/etc/gpmodes/common.nft"

table inet filter {
    chain input {
        type filter hook input priority 0; policy accept;
        ct state established,related accept
        iifname "lo" accept
        iifname $LAN_IF accept
        iifname $WAN_IF ct state established,related accept
    }

    chain forward {
        type filter hook forward priority 0; policy accept;
        ct state established,related accept
        # Drop IPv6 forwarding — prevent bypass via IPv6 tunnels
        meta nfproto ipv6 counter drop

        # Block DNS over TLS (DoT)
        iifname $LAN_IF tcp dport 853 drop
        iifname $LAN_IF udp dport 853 drop

        # Block known DoH servers by IP
        iifname $LAN_IF ip daddr { 8.8.8.8, 8.8.4.4, 1.1.1.1, 1.0.0.1, 9.9.9.9, 208.67.222.222, 208.67.220.220 } tcp dport 443 drop


        # Block QUIC (UDP 443) — forces browsers to fall back to TCP/HTTPS
        # which can be inspected and filtered by Pi-hole/DNS rules
        iifname $LAN_IF udp dport 443 drop comment "gp-quic-block"
        # Allow everything else
        iifname $LAN_IF oifname $WAN_IF accept
        iifname $WAN_IF oifname $LAN_IF ct state established,related accept
    }
}

table ip nat {
    chain prerouting {
        type nat hook prerouting priority -100;
        # Force all LAN DNS to Pi-hole — prevents clients from using hardcoded DNS
        iifname $LAN_IF tcp dport 53 redirect to :53
        iifname $LAN_IF udp dport 53 redirect to :53
    }

    chain postrouting {
        type nat hook postrouting priority srcnat; policy accept;
        oifname $WAN_IF masquerade
    }
}
