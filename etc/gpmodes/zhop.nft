flush ruleset
include "/etc/gpmodes/common.nft"

table inet filter {
    # Kill-switch chain — pre-installed default-active in tunnel mode.
    # Hooks forward at priority -10 so it fires before the main forward chain.
    # Policy drop with explicit wg1-only accepts: any non-tunnel forward path
    # (e.g. LAN→eth0 if wg1 drops and a stale route appears) is dropped here
    # before the main forward chain ever sees it. Quartermaster greps the live
    # ruleset for "killswitch" to verify presence (see gp-quartermaster.py
    # Kill Switch Armed check). gp-anchor.py disarm/arm tears down/rebuilds.
    chain killswitch {
        type filter hook forward priority -10; policy drop;
        oifname $WG_DATA counter accept

        iifname $WG_DATA ct state established,related counter accept

    }

    chain forward {
        type filter hook forward priority 0; policy drop;
        # MSS clamping — prevent fragmentation/stalls through WireGuard tunnel
        tcp flags syn tcp option maxseg size set rt mtu
        # Drop all IPv6 forwarded traffic to prevent tunnel bypass
        meta nfproto ipv6 counter drop
        ct state invalid counter drop

        ct state established,related counter accept

        # T-0175 — Block DoH-over-QUIC bypass: drop UDP/443 only to known DoH
        # resolver IPs, not to all destinations. The blanket UDP/443 drop the
        # previous gp-quic-block rule applied broke QUIC for everything (PS5
        # PSN, Switch Online, Chromebook HTTP/3 video). ZHop already routes
        # all DNS through wg_data + locks the resolver — this rule closes the
        # DNS-over-QUIC bypass to public resolvers.
        iifname $LAN_IF ip daddr { 8.8.8.8, 8.8.4.4, 1.1.1.1, 1.0.0.1, 9.9.9.9, 208.67.222.222, 208.67.220.220 } udp dport 443 counter drop comment "gp-doh-quic-block"

        # Block DoT (853) — forces DNS through Pi-hole
        iifname $LAN_IF tcp dport 853 counter drop comment "gp-dot-block"

        iifname $LAN_IF udp dport 853 counter drop comment "gp-dot-block"

        # LAN exits only through WireGuard (Tailscale handles mgmt)
        iifname $LAN_IF oifname $WG_DATA counter accept

        iifname $WG_DATA oifname $LAN_IF ct state established,related counter accept

    }

    chain output {
        type filter hook output priority 0; policy accept;
        # Block Pi's own IPv6 on WAN — prevents tunnel bypass
        oifname $WAN_IF meta nfproto ipv6 counter drop
        # Allow DNS to localhost (Pi-hole / cloudflared)
        ip daddr 127.0.0.1 udp dport 53 counter accept

        ip daddr 127.0.0.1 tcp dport 53 counter accept

        # Allow DNS to Tailscale MagicDNS
        ip daddr 100.100.100.100 udp dport 53 counter accept

        ip daddr 100.100.100.100 tcp dport 53 counter accept

        # Allow DNS out through WireGuard tunnel (Pi-hole upstream)
        oifname $WG_DATA udp dport 53 counter accept

        oifname $WG_DATA tcp dport 53 counter accept

        # Block DNS over any other interface to prevent leaks
        udp dport 53 counter drop

        tcp dport 53 counter drop

        # Block DoT from the Pi — prevent encrypted DNS bypass
        tcp dport 853 counter drop

        udp dport 853 counter drop

    }
}

table inet nat {
    chain prerouting {
        type nat hook prerouting priority -100;
        # Force ALL LAN DNS to Pi-hole, no exceptions
        iifname $LAN_IF tcp dport 53 redirect to :53
        iifname $LAN_IF udp dport 53 redirect to :53
    }

    chain postrouting {
        type nat hook postrouting priority srcnat; policy accept;
        # T-0195 follow-on: 'persistent' keeps the same source-port mapping
        # for a given inside endpoint regardless of destination — what NAT
        # detectors call 'cone NAT'. Without it, p2p game services (EA
        # matchmaking, PS5 Party voice) see strict NAT and refuse to connect.
        # Witnessed 2026-05-09 with EA error 990104014 on Skate.
        oifname $WG_DATA counter masquerade persistent

    }
}
