[Unit]
Description=GhostPort Alerter — multi-channel notification daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ghostport-admin
Group=ghostport-admin
ExecStart=/usr/bin/python3 /opt/ghostport/daemons/gp-alerter.py
Restart=on-failure
RestartSec=10
MemoryMax=64M
Nice=5

# Keep logs readable; no stderr dropouts
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
