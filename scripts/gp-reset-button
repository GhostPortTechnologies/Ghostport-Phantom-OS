#!/bin/bash
# gp-reset-button — GPIO 17 reset button daemon
# 10s hold: passcode reset
# 30s hold: factory reset
# GPIO 17 with internal pull-up, button connects to GND (active low)

set -euo pipefail

GPIO_PIN=17
GPIO_PATH="/sys/class/gpio/gpio${GPIO_PIN}"
DEBOUNCE_MS=100
LOG_TAG="gp-reset-button"

log() { logger -t "$LOG_TAG" "$1"; echo "[$LOG_TAG] $1"; }

# Export GPIO if not already
if [ ! -d "$GPIO_PATH" ]; then
  echo "$GPIO_PIN" > /sys/class/gpio/export
  sleep 0.1
fi

# Configure as input with pull-up
echo "in" > "${GPIO_PATH}/direction"
# Active low (button press = 0)
echo "1" > "${GPIO_PATH}/active_low" 2>/dev/null || true

log "Monitoring GPIO ${GPIO_PIN} for reset button..."

read_gpio() {
  cat "${GPIO_PATH}/value"
}

while true; do
  # Wait for button press (value = 1 when active_low and pressed)
  VAL=$(read_gpio)
  if [ "$VAL" = "1" ]; then
    # Button is pressed — start timing
    PRESS_START=$(date +%s)
    HOLD_SECONDS=0
    TRIGGERED=""

    while [ "$(read_gpio)" = "1" ]; do
      sleep 0.5
      NOW=$(date +%s)
      HOLD_SECONDS=$(( NOW - PRESS_START ))

      # Visual feedback: log hold duration at thresholds
      if [ "$HOLD_SECONDS" -ge 30 ] && [ -z "$TRIGGERED" ]; then
        TRIGGERED="factory"
        log "30s hold detected — FACTORY RESET triggered"
        break
      elif [ "$HOLD_SECONDS" -ge 10 ] && [ -z "$TRIGGERED" ]; then
        # Don't break yet — keep counting for 30s
        log "10s hold reached — release for PASSCODE RESET, keep holding for FACTORY RESET"
        TRIGGERED="passcode"
      fi
    done

    # Button released — act on what was detected
    if [ "$TRIGGERED" = "factory" ]; then
      log "Executing factory reset..."
      gp-factory-reset 2>&1 | logger -t "$LOG_TAG"
    elif [ "$TRIGGERED" = "passcode" ]; then
      log "Executing passcode reset..."
      NEW_PASS=$(gp-passcode reset 2>&1 | grep -oP 'GP-[A-Z0-9]{4}-[A-Z0-9]{4}-[A-Z0-9]{4}' || echo "unknown")
      # Write passcode to file for physical recovery (auto-deletes after 5 min)
      echo "$NEW_PASS" > /etc/phantom/last-reset-passcode.txt
      chmod 600 /etc/phantom/last-reset-passcode.txt
      ( sleep 300 && rm -f /etc/phantom/last-reset-passcode.txt ) &
      log "Passcode reset complete. Recovery file expires in 5 minutes."
      systemctl restart ghostport 2>/dev/null || true
    fi

    # Debounce — wait before monitoring again
    sleep 2
  fi

  # Poll interval
  sleep 0.2
done
