#!/usr/bin/env bash
# gp-allow — manage the GhostPort device passthrough allowlist (T-0177)
#
# Devices listed here bypass mode-specific firewall restrictions (DoH-IP
# blocks, DoT blocks, DNS forcing, etc) so game consoles, smart TVs and
# other modern QUIC-heavy devices can talk to the internet directly while
# the rest of the LAN stays under privacy enforcement.
#
# Source of truth: /etc/ghostport/passthrough.json
# Generated nft fragment: /etc/ghostport/custom-rules.nft (sourced by gp-mode)
#
# Usage
#   gp-allow add <MAC> <LABEL>   add a device (LABEL is free-text, e.g. "PS5")
#   gp-allow remove <MAC>        remove a device
#   gp-allow list                show current allowlist
#   gp-allow regenerate          rebuild custom-rules.nft from passthrough.json

set -uo pipefail

# --help guard
if [[ "${1:-}" == "-h" || "${1:-}" == "--help" || "${1:-}" == "help" ]]; then
  sed -n '2,/^set -uo/p' "$0" | sed 's/^# \{0,1\}//; /^set -uo/d'
  exit 0
fi

PASSTHROUGH_JSON="/etc/ghostport/passthrough.json"
CUSTOM_RULES="/etc/ghostport/custom-rules.nft"
LAN_IF="wlan0"

# theme
ACC=$'\033[1;32m'
DIM=$'\033[2m'
ERR=$'\033[1;31m'
RST=$'\033[0m'

die() { printf '%sgp-allow:%s %s\n' "$ERR" "$RST" "$*" >&2; exit 1; }

# Normalize MAC to upper-case colon-separated form
normalize_mac() {
  printf '%s' "$1" | tr 'a-f' 'A-F' | tr '-' ':' | grep -E '^([0-9A-F]{2}:){5}[0-9A-F]{2}$' || die "invalid MAC: $1"
}

# Bootstrap passthrough.json if missing
ensure_json() {
  if [ ! -f "$PASSTHROUGH_JSON" ]; then
    sudo install -m 644 -o root -g root /dev/null "$PASSTHROUGH_JSON"
    echo '{"devices": []}' | sudo tee "$PASSTHROUGH_JSON" >/dev/null
  fi
}

# Regenerate /etc/ghostport/custom-rules.nft from the JSON source.
# Uses `insert rule` so each device lands at the TOP of the forward chain,
# bypassing every mode-specific drop further down. gp-mode's apply_custom_rules
# runs this file on every mode switch, so allowlist persists across switches.
regenerate() {
  ensure_json
  local tmp
  tmp=$(mktemp)
  {
    echo "# Auto-generated by gp-allow — do not edit by hand."
    echo "# Source: $PASSTHROUGH_JSON"
    echo "# Each rule uses 'insert' so it lands at the top of the forward chain,"
    echo "# bypassing all mode-specific drops (DoH-IP, DoT, DNS forcing)."
    echo "# Trusted devices get full unrestricted internet."
    echo
    python3 -c "
import json
try:
    data = json.load(open('$PASSTHROUGH_JSON'))
except Exception:
    data = {'devices': []}
for d in data.get('devices', []):
    mac = d.get('mac', '').upper().replace('-', ':')
    label = d.get('label', '?').replace(chr(34), '')
    if not mac:
        continue
    print(f'insert rule inet filter forward iifname \"$LAN_IF\" ether saddr {mac} counter accept comment \"passthrough:{label}\"')
"
  } > "$tmp"
  sudo install -m 644 -o root -g root "$tmp" "$CUSTOM_RULES"
  rm -f "$tmp"
}

# Apply the generated rules to the live kernel right now (gp-mode would
# do this on next mode switch, but we want immediate effect).
apply_now() {
  if [ -f "$CUSTOM_RULES" ]; then
    if sudo nft -c -f "$CUSTOM_RULES" >/dev/null 2>&1; then
      sudo nft -f "$CUSTOM_RULES" || die "nft apply failed"
    else
      die "$CUSTOM_RULES failed dry-run validation"
    fi
  fi
}

cmd_add() {
  local mac label
  mac=$(normalize_mac "$1")
  label="${2:-device}"
  ensure_json
  local out
  out=$(sudo python3 -c "
import json, sys
data = json.load(open('$PASSTHROUGH_JSON'))
devs = data.setdefault('devices', [])
mac = '$mac'
if any(d.get('mac', '').upper() == mac for d in devs):
    print('exists')
else:
    devs.append({'mac': mac, 'label': '$label'})
    json.dump(data, open('$PASSTHROUGH_JSON', 'w'), indent=2)
    print('added')
")
  if [ "$out" = "exists" ]; then
    printf '%sgp-allow:%s %s already in allowlist\n' "$DIM" "$RST" "$mac"
  else
    regenerate
    apply_now
    printf '%sadded%s %s (%s)\n' "$ACC" "$RST" "$mac" "$label"
  fi
}

cmd_remove() {
  local mac
  mac=$(normalize_mac "$1")
  ensure_json
  local out
  out=$(sudo python3 -c "
import json
data = json.load(open('$PASSTHROUGH_JSON'))
devs = data.get('devices', [])
mac = '$mac'
new_devs = [d for d in devs if d.get('mac', '').upper() != mac]
if len(new_devs) == len(devs):
    print('not_found')
else:
    data['devices'] = new_devs
    json.dump(data, open('$PASSTHROUGH_JSON', 'w'), indent=2)
    print('removed')
")
  if [ "$out" = "not_found" ]; then
    printf '%sgp-allow:%s %s not in allowlist\n' "$DIM" "$RST" "$mac"
  else
    regenerate
    # Removing requires flushing + reapplying — gp-mode reapply or nft delete handle.
    # Easiest: rebuild file, tell user to gp-mode reapply for the removal to take effect.
    printf '%sremoved%s %s — run %ssudo gp-mode <current-mode>%s to flush the live rule\n' \
      "$ACC" "$RST" "$mac" "$ACC" "$RST"
  fi
}

cmd_list() {
  ensure_json
  python3 -c "
import json
data = json.load(open('$PASSTHROUGH_JSON'))
devs = data.get('devices', [])
if not devs:
    print('  (allowlist empty)')
else:
    for d in devs:
        print(f\"  {d.get('mac', '?'):20}  {d.get('label', '?')}\")"
}

# main
case "${1:-list}" in
  add)
    [ "$#" -ge 3 ] || die "usage: gp-allow add <MAC> <LABEL>"
    cmd_add "$2" "$3"
    ;;
  remove|rm|del)
    [ "$#" -eq 2 ] || die "usage: gp-allow remove <MAC>"
    cmd_remove "$2"
    ;;
  list|ls|"")
    cmd_list
    ;;
  regenerate|regen)
    regenerate
    apply_now
    echo "regenerated $CUSTOM_RULES"
    ;;
  *)
    die "unknown command: $1 — try gp-allow --help"
    ;;
esac
