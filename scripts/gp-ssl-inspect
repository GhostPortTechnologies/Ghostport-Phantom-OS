#!/usr/bin/env bash
# gp-ssl-inspect — Manage GhostPort SNI Inspector for Family Shield
# Usage: gp-ssl-inspect start|stop|status|add-device <ip>|remove-device <ip>|flush

set -euo pipefail

NFT_TABLE="inet ghostport_sni"
NFT_CHAIN="sni_redirect"
LISTEN_PORT=8443
PID_FILE="/run/ghostport-sni.pid"
SERVICE="ghostport-sni"
STATE_FILE="/etc/phantom/sni-devices.json"

log() { echo "[gp-ssl-inspect] $*"; }

# Validate IP is 192.168.50.1-254 (strict octet check)
validate_ip() {
    local ip="$1"
    if ! [[ "$ip" =~ ^192\.168\.50\.([0-9]{1,3})$ ]]; then
        return 1
    fi
    local octet="${BASH_REMATCH[1]}"
    if [ "$octet" -lt 1 ] || [ "$octet" -gt 254 ]; then
        return 1
    fi
    return 0
}

ensure_nft_table() {
    nft add table $NFT_TABLE 2>/dev/null || true
    nft add chain $NFT_TABLE $NFT_CHAIN '{ type nat hook prerouting priority dstnat - 5; policy accept; }' 2>/dev/null || true
}

start() {
    if systemctl is-active --quiet "$SERVICE" 2>/dev/null; then
        log "Already running"
        return 0
    fi
    ensure_nft_table
    systemctl start "$SERVICE"
    log "Started"
}

stop() {
    systemctl stop "$SERVICE" 2>/dev/null || true
    nft delete table $NFT_TABLE 2>/dev/null || true
    log "Stopped and flushed redirect rules"
}

status() {
    if systemctl is-active --quiet "$SERVICE" 2>/dev/null; then
        echo "running"
        nft list table $NFT_TABLE 2>/dev/null || echo "No redirect rules"
    else
        echo "stopped"
    fi
}

add_device() {
    local ip="$1"
    if ! validate_ip "$ip"; then
        log "ERROR: Invalid IP — must be 192.168.50.1-254"
        return 1
    fi

    ensure_nft_table

    if nft list chain $NFT_TABLE $NFT_CHAIN 2>/dev/null | grep -q "sni_inspect_${ip}\""; then
        log "Rule already exists for $ip"
        return 0
    fi

    nft add rule $NFT_TABLE $NFT_CHAIN \
        ip saddr "$ip" tcp dport 443 redirect to :"$LISTEN_PORT" \
        comment "\"sni_inspect_${ip}\""

    log "Added SNI inspection for $ip"
    _save_device "$ip"
}

remove_device() {
    local ip="$1"
    if ! validate_ip "$ip"; then
        log "ERROR: Invalid IP"
        return 1
    fi

    local handle
    handle=$(nft -a list chain $NFT_TABLE $NFT_CHAIN 2>/dev/null \
        | grep "sni_inspect_${ip}\"" \
        | awk '{print $NF}' | tail -1)

    if [ -n "$handle" ]; then
        nft delete rule $NFT_TABLE $NFT_CHAIN handle "$handle"
        log "Removed SNI inspection for $ip"
    else
        log "No rule found for $ip"
    fi
    _unsave_device "$ip"
}

flush() {
    nft flush chain $NFT_TABLE $NFT_CHAIN 2>/dev/null || true
    echo '{"devices":[]}' > "$STATE_FILE"
    log "Flushed all SNI inspection rules"
}

restore() {
    if [ ! -f "$STATE_FILE" ]; then
        return 0
    fi
    ensure_nft_table
    # Safe: pass file path as argument, not interpolated into code
    local devices
    devices=$(python3 -c "
import json, sys
try:
    d = json.load(open(sys.argv[1]))
    for ip in d.get('devices', []):
        print(ip)
except: pass
" "$STATE_FILE" 2>/dev/null)

    for ip in $devices; do
        add_device "$ip" 2>/dev/null || true
    done
}

_save_device() {
    local ip="$1"
    # Safe: pass IP and file path as arguments, not interpolated into code
    python3 -c "
import json, sys
ip, f = sys.argv[1], sys.argv[2]
try:
    d = json.load(open(f))
except: d = {'devices': []}
if ip not in d['devices']:
    d['devices'].append(ip)
json.dump(d, open(f, 'w'))
" "$ip" "$STATE_FILE" 2>/dev/null || true
}

_unsave_device() {
    local ip="$1"
    python3 -c "
import json, sys
ip, f = sys.argv[1], sys.argv[2]
try:
    d = json.load(open(f))
except: d = {'devices': []}
d['devices'] = [x for x in d['devices'] if x != ip]
json.dump(d, open(f, 'w'))
" "$ip" "$STATE_FILE" 2>/dev/null || true
}

case "${1:-}" in
    start)    start ;;
    stop)     stop ;;
    status)   status ;;
    add-device)
        [ -z "${2:-}" ] && { echo "Usage: gp-ssl-inspect add-device <ip>"; exit 1; }
        add_device "$2"
        ;;
    remove-device)
        [ -z "${2:-}" ] && { echo "Usage: gp-ssl-inspect remove-device <ip>"; exit 1; }
        remove_device "$2"
        ;;
    flush)    flush ;;
    restore)  restore ;;
    *)
        echo "Usage: gp-ssl-inspect {start|stop|status|add-device <ip>|remove-device <ip>|flush|restore}"
        exit 1
        ;;
esac
