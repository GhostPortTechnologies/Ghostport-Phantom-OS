#!/bin/bash
# gp-provision — One-command manufacturing provisioning for GhostPort units
# Usage: sudo gp-provision --tailscale-key=tskey-auth-... --license-key=GP-XXXX-XXXX-XXXX

set -euo pipefail

if [ "$(id -u)" -ne 0 ]; then
  echo "Error: must run as root (sudo gp-provision ...)"
  exit 1
fi

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'
PROVISION_FILE="/etc/phantom/provision.json"

log() { echo -e "${GREEN}[PROVISION]${NC} $1"; }
warn() { echo -e "${YELLOW}[PROVISION]${NC} $1"; }
err() { echo -e "${RED}[PROVISION]${NC} $1"; exit 1; }

# Parse arguments
TS_KEY=""
LICENSE_KEY=""
FLEET_TOKEN=""
FLEET_SERVER="http://10.66.66.1:8080"

for arg in "$@"; do
  case "$arg" in
    --tailscale-key=*) TS_KEY="${arg#*=}" ;;
    --license-key=*) LICENSE_KEY="${arg#*=}" ;;
    --fleet-token=*) FLEET_TOKEN="${arg#*=}" ;;
    --fleet-server=*) FLEET_SERVER="${arg#*=}" ;;
    *) err "Unknown argument: $arg" ;;
  esac
done

if [ -z "$TS_KEY" ]; then
  err "Missing --tailscale-key=tskey-auth-..."
fi
if [ -z "$LICENSE_KEY" ]; then
  err "Missing --license-key=GP-XXXX-XXXX-XXXX"
fi

# Get device serial
SERIAL=$(grep -oP 'Serial\s*:\s*\K\S+' /proc/cpuinfo 2>/dev/null || echo "unknown")
HOSTNAME_BASE="ghostport-${SERIAL: -8}"

log "╔═══════════════════════════════════════════════╗"
log "║   GhostPort Manufacturing Provisioning        ║"
log "╚═══════════════════════════════════════════════╝"
log ""
log "Serial:       $SERIAL"
log "Hostname:     $HOSTNAME_BASE"
log "License:      $LICENSE_KEY"
log ""

ERRORS=()
WARNINGS=()

# Step 1: Deploy latest code
log "Step 1/6: Deploying latest code..."
if [ -f /opt/phantom/scripts/gp-deploy ]; then
  bash /opt/phantom/scripts/gp-deploy --update 2>&1 | tail -5
else
  warn "gp-deploy not found — skipping code deploy"
  WARNINGS+=("gp-deploy not found")
fi

# Step 2: Set hostname
log "Step 2/6: Setting hostname..."
hostnamectl set-hostname "$HOSTNAME_BASE" 2>/dev/null || warn "Failed to set hostname"

# Step 3: Tailscale enrollment
log "Step 3/6: Enrolling in Tailscale..."
if tailscale status >/dev/null 2>&1; then
  CURRENT_TS=$(tailscale status --json 2>/dev/null | python3 -c "import sys,json; print(json.load(sys.stdin).get('Self',{}).get('HostName',''))" 2>/dev/null || echo "")
  if [ -n "$CURRENT_TS" ]; then
    warn "Already enrolled as '$CURRENT_TS' — re-enrolling..."
    tailscale down 2>/dev/null || true
  fi
fi

if ! tailscale up --authkey="$TS_KEY" --hostname="$HOSTNAME_BASE" --accept-routes --timeout=30s 2>&1; then
  err "Tailscale enrollment failed"
fi
log "Tailscale enrolled as $HOSTNAME_BASE"

# Step 4: Write fleet-auth.json (provisioning token for first activation)
log "Step 4/6: Writing fleet provisioning config..."
mkdir -p /etc/phantom
if [ -n "$FLEET_TOKEN" ]; then
  python3 -c "
import json
conf = {'fleet_token': '$FLEET_TOKEN', 'fleet_server': '$FLEET_SERVER', 'license_key': '$LICENSE_KEY'}
with open('/etc/phantom/fleet-auth.json', 'w') as f:
    json.dump(conf, f, indent=2)
"
  chmod 600 /etc/phantom/fleet-auth.json
  log "Fleet auth written"
else
  warn "No --fleet-token provided — device will need manual fleet registration"
  WARNINGS+=("No fleet token")
fi

# Step 5: Write initial version.json
log "Step 5/6: Writing version info..."
CURRENT_VERSION=$(python3 -c "import json; print(json.load(open('/etc/phantom/version.json'))['version'])" 2>/dev/null || echo "0.1.0")
python3 -c "
import json, datetime
v = {'version': '$CURRENT_VERSION', 'buildDate': datetime.datetime.utcnow().isoformat() + 'Z', 'updateAvailable': None}
with open('/etc/phantom/version.json', 'w') as f:
    json.dump(v, f, indent=2)
"
chmod 600 /etc/phantom/version.json

# Step 6: Verify services
log "Step 6/6: Running connectivity smoke test..."

# Ensure services are running
systemctl restart ghostport 2>/dev/null || ERRORS+=("ghostport service failed to restart")
sleep 3

# Check dashboard
if curl -sf --max-time 5 http://127.0.0.1:4200/api/auth/check >/dev/null 2>&1; then
  log "Dashboard: OK (port 4200)"
else
  ERRORS+=("Dashboard not responding on port 4200")
fi

# Check Tailscale
if tailscale status >/dev/null 2>&1; then
  TS_IP=$(tailscale ip -4 2>/dev/null || echo "unknown")
  log "Tailscale: OK ($TS_IP)"
else
  ERRORS+=("Tailscale not connected")
fi

# Check hostapd
if systemctl is-active hostapd >/dev/null 2>&1; then
  log "WiFi AP: OK"
else
  WARNINGS+=("hostapd not running")
fi

# Check Pi-hole
if curl -sf --max-time 5 http://127.0.0.1:80/api/dns/status >/dev/null 2>&1; then
  log "Pi-hole: OK"
else
  WARNINGS+=("Pi-hole not responding")
fi

# Check nftables
if nft list ruleset >/dev/null 2>&1; then
  log "Firewall: OK"
else
  ERRORS+=("nftables not loaded")
fi

# Write provision report
python3 -c "
import json, datetime
report = {
  'serial': '$SERIAL',
  'hostname': '$HOSTNAME_BASE',
  'license_key': '$LICENSE_KEY',
  'tailscale_ip': '$(tailscale ip -4 2>/dev/null || echo "unknown")',
  'provisioned_at': datetime.datetime.utcnow().isoformat() + 'Z',
  'version': '$CURRENT_VERSION',
  'errors': $(python3 -c "import json; print(json.dumps([$(printf '"%s",' "${ERRORS[@]}" 2>/dev/null || echo "")]))" 2>/dev/null || echo '[]'),
  'warnings': $(python3 -c "import json; print(json.dumps([$(printf '"%s",' "${WARNINGS[@]}" 2>/dev/null || echo "")]))" 2>/dev/null || echo '[]'),
  'status': '$( [ ${#ERRORS[@]} -eq 0 ] && echo "pass" || echo "fail" )'
}
with open('$PROVISION_FILE', 'w') as f:
    json.dump(report, f, indent=2)
"
chmod 600 "$PROVISION_FILE"

# Summary
echo ""
log "═══════════════════════════════════════════════"
if [ ${#ERRORS[@]} -eq 0 ]; then
  log "  PROVISIONING COMPLETE ✓"
else
  echo -e "${RED}[PROVISION]  PROVISIONING FAILED${NC}"
  for e in "${ERRORS[@]}"; do
    echo -e "${RED}  - $e${NC}"
  done
fi
if [ ${#WARNINGS[@]} -gt 0 ]; then
  for w in "${WARNINGS[@]}"; do
    echo -e "${YELLOW}  ⚠ $w${NC}"
  done
fi
log ""
log "  Serial:     $SERIAL"
log "  Hostname:   $HOSTNAME_BASE"
log "  Tailscale:  $(tailscale ip -4 2>/dev/null || echo 'not connected')"
log "  Dashboard:  http://$(hostname -I | awk '{print $1}'):4200"
log "  License:    $LICENSE_KEY"
log "═══════════════════════════════════════════════"
echo ""

# Exit with error if any checks failed
[ ${#ERRORS[@]} -eq 0 ] || exit 1
