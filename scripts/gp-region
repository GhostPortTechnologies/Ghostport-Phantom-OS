#!/bin/bash
# gp-region — switch wg1 EC2 region (data plane endpoint)
# Discovery: /api/regions on fleet API (via wg0 control plane)
# State: /etc/ghostport/active-region.json
# Rollback snapshots: /etc/ghostport/wg1-rollback/

set -uo pipefail

# --- --help early-exit guard (BEFORE any while loop) ---
if [[ "${1:-}" == "--help" || "${1:-}" == "-h" || "${1:-}" == "help" ]]; then
  cat <<'EOF'
gp-region — pick which AWS region terminates the wg1 data plane

USAGE
  gp-region status               Show current active region + handshake age
  gp-region list                 List all available regions from fleet API
  gp-region switch <region-id>   Live-swap wg1 to <region-id> + arm 60s rollback
  gp-region confirm              Cancel rollback timer (commits the switch)
  gp-region rollback             Revert to previous region immediately
  gp-region refresh              Re-pull region list from fleet API into local cache

SAFETY
  Every switch:
    1. snapshots /etc/wireguard/wg1.conf to /etc/ghostport/wg1-rollback/
    2. wg setconf in-place (no interface bounce, no route change)
    3. waits for fresh handshake (max 15s)
    4. dual-check verify: handshake age <30s AND exit-IP matches expected EC2 IP
    5. if BOTH pass: arm 60s auto-rollback timer (systemd-managed)
    6. if EITHER fails: auto-rollback immediately, exit non-zero
    7. operator runs 'gp-region confirm' to clear the timer

EXIT CODES
  0  success
  1  invalid args / region not found
  2  fleet API unreachable
  3  switch failed (auto-rolled back to previous region)
EOF
  exit 0
fi

# --- theme ---
THEME_LIB="/usr/local/lib/gp-theme-colors.sh"
# shellcheck source=/dev/null
[ -r "$THEME_LIB" ] && source "$THEME_LIB"
ACC="${GP_ACCENT:-$'\033[1;32m'}"
DIM="${GP_DIM:-$'\033[2m'}"
WARN="${GP_WARN:-$'\033[1;33m'}"
ERR="${GP_DANGER:-$'\033[1;31m'}"
RST="${GP_RESET:-$'\033[0m'}"

# --- paths ---
STATE_FILE="/etc/ghostport/active-region.json"
ROLLBACK_DIR="/etc/ghostport/wg1-rollback"
CACHE_FILE="/etc/ghostport/regions-cache.json"
WG_CONF="/etc/wireguard/wg1.conf"
API_URL="http://10.66.66.1:8080/api/regions"
ROLLBACK_TIMER_UNIT="gp-region-rollback.timer"
ROLLBACK_SVC_UNIT="gp-region-rollback.service"

# --- helpers ---
die() { printf '%sgp-region:%s %s\n' "$ACC" "$RST" "$*" >&2; exit "${2:-1}"; }
need() { command -v "$1" >/dev/null 2>&1 || die "missing dependency: $1"; }
log() { printf '%s[%s]%s %s\n' "$DIM" "$(date +%H:%M:%S)" "$RST" "$*"; }

fetch_regions() {
  local out
  out=$(curl -s --max-time 5 "$API_URL" 2>/dev/null) || return 1
  [ -z "$out" ] && return 1
  echo "$out" | python3 -m json.tool >/dev/null 2>&1 || return 1
  printf '%s' "$out"
}

read_regions() {
  # T-PI-1: prefer fleet API (fresh) but fall back to local cache when wg0 is
  # down (ISP/ZeroTrust modes — fleet API at 10.66.66.1 is unreachable there).
  # Use this for read-only ops (list, switch); cmd_refresh still uses
  # fetch_regions directly since it MUST hit the upstream source.
  local data=""
  data=$(fetch_regions 2>/dev/null)
  if [ -z "$data" ] && [ -r "$CACHE_FILE" ]; then
    data=$(cat "$CACHE_FILE" 2>/dev/null)
  fi
  [ -z "$data" ] && return 1
  printf '%s' "$data"
}

apply_wg_conf() {
  # Convert /etc/wireguard/wg1.conf -> wg setconf-compatible (strip wg-quick-only fields)
  local tmp
  tmp=$(sudo mktemp); sudo chmod 600 "$tmp"
  sudo grep -v '^Address\|^DNS\|^PostUp\|^PostDown\|^SaveConfig' "$WG_CONF" | sudo tee "$tmp" >/dev/null
  sudo wg setconf wg1 "$tmp"
  local rc=$?
  sudo rm -f "$tmp"
  return $rc
}

pin_endpoint_route() {
  # T-0173: pin a host-route for the wg1 endpoint via the WAN gateway, so the
  # encrypted UDP packet doesn't get routed through the wg1 default route
  # itself (recursive loop — first symptom: handshake init never leaves the
  # Pi, EC2 tcpdump sees zero packets, dual-check times out at 15s).
  # gp-mode pins this at boot for the boot-time endpoint; gp-region must
  # repin on every region switch and rollback.
  local ip="$1"
  [ -z "$ip" ] && return 1
  local gw wif
  read -r gw wif < <(ip route show default 2>/dev/null | awk '/^default via/ && /eth0/ {print $3, $5; exit}')
  if [ -z "$gw" ] || [ -z "$wif" ]; then
    log "warning: could not derive WAN gateway/iface — endpoint pin skipped"
    return 1
  fi
  sudo ip route replace "$ip" via "$gw" dev "$wif" 2>/dev/null && \
    log "pinned endpoint $ip via $gw dev $wif"
}

verify_path() {
  # Returns 0 if dual-check passes (handshake fresh AND exit IP matches expected)
  local expected_endpoint_ip="$1"
  local handshake_age
  handshake_age=$(sudo wg show wg1 latest-handshakes 2>/dev/null | awk '{print $2}')
  if [ -z "$handshake_age" ] || [ "$handshake_age" -eq 0 ]; then
    log "verify: no handshake yet"
    return 1
  fi
  local now age
  now=$(date +%s)
  age=$((now - handshake_age))
  if [ "$age" -gt 30 ]; then
    log "verify: handshake too old (${age}s, max 30s)"
    return 1
  fi
  local seen
  seen=$(curl -s --max-time 6 https://api.ipify.org 2>/dev/null)
  if [ "$seen" != "$expected_endpoint_ip" ]; then
    log "verify: exit IP mismatch (saw '$seen', expected '$expected_endpoint_ip' — kernel likely fell back to eth0)"
    return 1
  fi
  log "verify: handshake ${age}s, exit-IP $seen ✓"
  return 0
}

# --- subcommands ---
cmd_status() {
  if [ ! -r "$STATE_FILE" ]; then
    printf 'current region: %s(unknown — state file missing)%s\n' "$DIM" "$RST"
    printf '  hint: run %sgp-region refresh%s to bootstrap from fleet API\n' "$ACC" "$RST"
    return 0
  fi
  need jq
  local id ts prev rb
  id=$(jq -r '.id // "unknown"' "$STATE_FILE")
  ts=$(jq -r '.switched_at // 0' "$STATE_FILE")
  prev=$(jq -r '.previous_id // ""' "$STATE_FILE")
  rb=$(jq -r '.rollback_timer // "null"' "$STATE_FILE")
  printf 'current region: %s%s%s\n' "$ACC" "$id" "$RST"
  if [ "$ts" -gt 0 ]; then
    printf 'last switch:    %s\n' "$(date -d "@$ts" '+%Y-%m-%d %H:%M:%S %Z')"
  fi
  [ -n "$prev" ] && printf 'previous:       %s\n' "$prev"
  if [ "$rb" != "null" ] && systemctl is-active --quiet "$ROLLBACK_TIMER_UNIT" 2>/dev/null; then
    printf '%srollback timer ARMED — run %sgp-region confirm%s to commit OR %sgp-region rollback%s to revert%s\n' \
      "$WARN" "$ACC" "$WARN" "$ACC" "$WARN" "$RST"
  fi
  # Live wg1 state
  local ep
  ep=$(sudo wg show wg1 endpoints 2>/dev/null | awk '{print $2}')
  [ -n "$ep" ] && printf 'wg1 endpoint:   %s\n' "$ep"
}

cmd_list() {
  need jq
  local data
  data=$(read_regions) || die "no fleet data — cache empty AND fleet API unreachable (wg0 down). Run 'sudo gp-region refresh' from DoubleHop/ZHop to populate the cache." 2
  printf '%s%-12s %-30s %-25s %s%s\n' "$ACC" "ID" "LABEL" "ENDPOINT" "STATUS" "$RST"
  echo "$data" | jq -r '.regions[] | [.id, .label, .endpoint, .status] | @tsv' \
    | while IFS=$'\t' read -r id label endpoint status; do
        printf '%-12s %-30s %-25s %s\n' "$id" "$label" "$endpoint" "$status"
      done
  local def
  def=$(echo "$data" | jq -r '.default_region // ""')
  [ -n "$def" ] && printf '%sdefault: %s%s\n' "$DIM" "$def" "$RST"
}

cmd_switch() {
  local target="${1:-}"
  [ -z "$target" ] && die "usage: gp-region switch <region-id> (use 'gp-region list' to see options)"
  need jq

  # Load fleet config
  local data peer
  data=$(read_regions) || die "no fleet data — cache empty AND fleet API unreachable (wg0 down). Run 'sudo gp-region refresh' from DoubleHop/ZHop to populate the cache." 2
  peer=$(echo "$data" | jq --arg id "$target" '.regions[] | select(.id == $id)')
  [ -z "$peer" ] && die "region '$target' not found in fleet API"

  local new_endpoint new_pubkey new_endpoint_ip
  new_endpoint=$(echo "$peer" | jq -r '.endpoint')
  new_pubkey=$(echo "$peer" | jq -r '.pubkey')
  new_endpoint_ip="${new_endpoint%:*}"

  # Current region check
  local current="unknown"
  [ -r "$STATE_FILE" ] && current=$(jq -r '.id // "unknown"' "$STATE_FILE")
  if [ "$current" = "$target" ]; then
    log "already on $target — no switch needed"
    exit 0
  fi

  # Refuse if rollback timer already armed (operator must confirm/rollback first)
  if systemctl is-active --quiet "$ROLLBACK_TIMER_UNIT" 2>/dev/null; then
    die "rollback timer already armed for previous switch — run 'gp-region confirm' or 'gp-region rollback' first"
  fi

  log "switching wg1: $current -> $target"

  # 1. Snapshot
  sudo mkdir -p "$ROLLBACK_DIR"
  sudo chmod 700 "$ROLLBACK_DIR"
  local snap="$ROLLBACK_DIR/wg1.conf.bak.$(date +%Y%m%d-%H%M%S)"
  sudo cp -p "$WG_CONF" "$snap"
  sudo chmod 600 "$snap"
  log "snapshot: $snap"

  # 2. Rewrite wg1.conf endpoint+pubkey (PrivateKey untouched)
  sudo sed -i "s|^Endpoint *=.*|Endpoint = $new_endpoint|" "$WG_CONF"
  sudo sed -i "s|^PublicKey *=.*|PublicKey = $new_pubkey|" "$WG_CONF"

  # 2a. T-0173: pin host-route for new endpoint BEFORE wg setconf, so the
  # very first handshake init has correct routing (eth0, not wg1 itself).
  pin_endpoint_route "$new_endpoint_ip"

  # 3. Apply via wg setconf (no interface bounce)
  if ! apply_wg_conf; then
    log "%swg setconf FAILED — restoring snapshot%s" "$ERR" "$RST"
    sudo cp -p "$snap" "$WG_CONF"
    apply_wg_conf || true
    die "switch failed at wg setconf step (rolled back)" 3
  fi

  # 4. Wait for handshake (poll up to 15s)
  log "waiting for handshake (max 15s)..."
  local i ok=0
  for i in $(seq 1 15); do
    sleep 1
    if verify_path "$new_endpoint_ip"; then
      ok=1; break
    fi
  done

  # 5. Dual-check verify result
  if [ "$ok" -ne 1 ]; then
    log "%sdual-check FAILED — auto-rolling back%s" "$ERR" "$RST"
    sudo cp -p "$snap" "$WG_CONF"
    apply_wg_conf || true
    # T-0173: re-pin the restored endpoint so traffic egresses eth0, not wg1.
    local restored_ip
    restored_ip=$(sudo grep -oP '^Endpoint\s*=\s*\K[^:]+' "$WG_CONF" 2>/dev/null | head -1)
    [ -n "$restored_ip" ] && pin_endpoint_route "$restored_ip"
    die "switch failed (dual-check timeout); restored snapshot from $snap" 3
  fi

  # 6. Persist new state
  local now=$(date +%s)
  sudo tee "$STATE_FILE" >/dev/null <<EOF
{
  "id": "$target",
  "switched_at": $now,
  "switched_by": "$(whoami)",
  "rollback_timer": "armed",
  "previous_id": "$current",
  "rollback_snapshot": "$snap"
}
EOF
  sudo chmod 644 "$STATE_FILE"

  # 7. Arm 60s auto-rollback timer (systemd-run, transient unit)
  sudo systemctl reset-failed "$ROLLBACK_SVC_UNIT" 2>/dev/null || true
  sudo systemd-run --unit="$ROLLBACK_SVC_UNIT" --on-active=60 \
    /usr/local/bin/gp-region rollback --auto >/dev/null 2>&1 || \
    log "warning: failed to arm systemd rollback timer (manual rollback still works)"

  printf '\n%sSWITCHED to %s%s\n' "$ACC" "$target" "$RST"
  printf 'Endpoint: %s\n' "$new_endpoint"
  printf 'Exit IP:  %s\n' "$new_endpoint_ip"
  printf '\n%sRollback timer ARMED — auto-revert in 60s.%s\n' "$WARN" "$RST"
  printf 'Run %sgp-region confirm%s to keep it,\nor %sgp-region rollback%s to revert now.\n' \
    "$ACC" "$RST" "$ACC" "$RST"
}

cmd_confirm() {
  if ! systemctl is-active --quiet "$ROLLBACK_TIMER_UNIT" 2>/dev/null && \
     ! systemctl is-active --quiet "$ROLLBACK_SVC_UNIT" 2>/dev/null; then
    log "no rollback timer armed — nothing to confirm"
    return 0
  fi
  sudo systemctl stop "$ROLLBACK_TIMER_UNIT" "$ROLLBACK_SVC_UNIT" 2>/dev/null || true
  # Update state: clear rollback flag
  if [ -r "$STATE_FILE" ]; then
    local tmp
    tmp=$(mktemp)
    jq '.rollback_timer = null | del(.rollback_snapshot)' "$STATE_FILE" > "$tmp"
    sudo cp "$tmp" "$STATE_FILE"
    rm -f "$tmp"
  fi
  printf '%sCONFIRMED — rollback timer cleared%s\n' "$ACC" "$RST"
}

resolve_region_by_endpoint() {
  # T-0163: look up region id by endpoint IP. Tries cache first, then fleet API.
  # Echoes id (or "unknown"). Never fails — rollback must always update state.
  local ip="$1"
  local data=""
  [ -r "$CACHE_FILE" ] && data=$(cat "$CACHE_FILE" 2>/dev/null)
  [ -z "$data" ] && data=$(fetch_regions 2>/dev/null || echo "")
  if [ -n "$data" ]; then
    local id
    id=$(echo "$data" | jq -r --arg ip "$ip" '.regions[] | select(.endpoint | startswith($ip + ":")) | .id' 2>/dev/null | head -1)
    [ -n "$id" ] && { echo "$id"; return 0; }
  fi
  echo "unknown"
}

cmd_rollback() {
  local auto=""
  [ "${1:-}" = "--auto" ] && auto="auto-"
  local snap=""
  [ -r "$STATE_FILE" ] && snap=$(jq -r '.rollback_snapshot // ""' "$STATE_FILE")
  if [ -z "$snap" ] || [ ! -r "$snap" ]; then
    # Fall back to most recent snapshot in rollback dir
    snap=$(sudo ls -t "$ROLLBACK_DIR"/*.bak.* 2>/dev/null | head -1 || echo "")
  fi
  [ -z "$snap" ] && die "no rollback snapshot found"
  log "${auto}rollback: restoring $snap"

  # T-0188: capture prev_id BEFORE we touch state, so even a mid-flight crash
  # leaves the operator with the right "what was I rolling back from?" trail.
  local prev_id=""
  [ -r "$STATE_FILE" ] && prev_id=$(jq -r '.id // ""' "$STATE_FILE")

  # Apply the rollback. Capture exit codes — DO NOT die mid-flight, since
  # that left state lying about the live region (root cause of T-0188).
  sudo cp -p "$snap" "$WG_CONF"
  local apply_rc=0
  apply_wg_conf || apply_rc=$?

  # T-0173: re-pin restored endpoint so first packet through restored tunnel
  # egresses eth0, not the wg1 default route.
  local rb_ip
  rb_ip=$(sudo grep -oP '^Endpoint\s*=\s*\K[^:]+' "$WG_CONF" 2>/dev/null | head -1)
  [ -n "$rb_ip" ] && pin_endpoint_route "$rb_ip"

  # T-0163: derive id from the restored Endpoint, not state.previous_id —
  # previous_id is null after a chained rollback.
  local restored_ip new_id
  restored_ip="$rb_ip"
  new_id=$(resolve_region_by_endpoint "$restored_ip")
  local now
  now=$(date +%s)

  # T-0188: write state file with id derived from ACTUAL live wg1.conf,
  # plus an apply_rc field so a failed apply is visible in state — never
  # implicit. Operators reading active-region.json see the inconsistency
  # explicitly instead of state silently disagreeing with wg1.conf.
  if [ "$apply_rc" -eq 0 ]; then
    sudo tee "$STATE_FILE" >/dev/null <<EOF
{
  "id": "$new_id",
  "switched_at": $now,
  "switched_by": "rollback",
  "rollback_timer": null,
  "previous_id": "$prev_id"
}
EOF
  else
    sudo tee "$STATE_FILE" >/dev/null <<EOF
{
  "id": "$new_id",
  "switched_at": $now,
  "switched_by": "rollback",
  "rollback_timer": null,
  "previous_id": "$prev_id",
  "last_apply_error": "wg setconf failed during rollback (rc=$apply_rc) — wg1.conf restored, kernel state may differ"
}
EOF
  fi
  sudo chmod 644 "$STATE_FILE"

  # Only stop the timer service when invoked manually — auto-mode is already running inside it and will die naturally.
  if [ "$auto" != "auto-" ]; then
    sudo systemctl stop "$ROLLBACK_TIMER_UNIT" "$ROLLBACK_SVC_UNIT" 2>/dev/null || true
  fi

  if [ "$apply_rc" -ne 0 ]; then
    log "${ERR}rollback wg setconf FAILED rc=${apply_rc} — wg1.conf restored, kernel may need manual reload${RST}"
    printf '%sROLLED BACK (with apply error) to %s — see active-region.json for last_apply_error%s\n' "$WARN" "$new_id" "$RST"
    exit 3
  fi
  printf '%sROLLED BACK to %s%s\n' "$ACC" "$new_id" "$RST"
}

cmd_refresh() {
  local data
  data=$(fetch_regions) || die "fleet API unreachable at $API_URL" 2
  echo "$data" | sudo tee "$CACHE_FILE" >/dev/null
  sudo chmod 644 "$CACHE_FILE"
  printf '%scached %d bytes -> %s%s\n' "$ACC" "${#data}" "$CACHE_FILE" "$RST"
}

# --- dispatch ---
case "${1:-status}" in
  status)   cmd_status ;;
  list)     cmd_list ;;
  switch)   shift; cmd_switch "${1:-}" ;;
  confirm)  cmd_confirm ;;
  rollback) shift; cmd_rollback "${1:-}" ;;
  refresh)  cmd_refresh ;;
  *)        die "unknown command '$1' — try gp-region --help" ;;
esac
