#!/usr/bin/env python3
"""gp-bridge — Signed & encrypted bridge message helper for Pi <-> EC2 Claude.
Usage:
  gp-bridge send <type> <body>       Send a signed message to EC2
  gp-bridge read                     Read & verify messages from EC2
  gp-bridge ack <id>                 Ack a message by ID
  gp-bridge ack-all                  Ack all messages for pi
"""

import sys
import os
import json
import hmac
import hashlib
import time
import secrets
import urllib.request
import urllib.error

CONFIG_FILE = "/etc/phantom/fleet-auth.json"

def load_config():
    with open(CONFIG_FILE) as f:
        return json.load(f)

def get_bridge_secret(config):
    secret = config.get("bridge_secret")
    if not secret:
        print("ERROR: no bridge_secret in fleet-auth.json", file=sys.stderr)
        sys.exit(1)
    return secret

def sign_message(secret, from_val, to_val, msg_type, body, timestamp):
    message = f"{from_val}|{to_val}|{msg_type}|{body}|{timestamp}"
    return hmac.new(secret.encode(), message.encode(), hashlib.sha256).hexdigest()

def verify_message(secret, msg):
    sig = msg.get("signature")
    if not sig:
        return None  # unsigned legacy message
    expected = sign_message(
        secret,
        msg.get("from", ""),
        msg.get("to", ""),
        msg.get("type", ""),
        msg.get("body", ""),
        str(msg.get("timestamp", ""))
    )
    return hmac.compare_digest(expected, sig)

def send_message(config, msg_type, body):
    secret = get_bridge_secret(config)
    server = config.get("fleet_server", "http://10.66.66.1:8080")
    token = config.get("bridge_token", "MISSING_BRIDGE_TOKEN")
    timestamp = int(time.time())
    nonce = secrets.token_hex(16)
    signature = sign_message(secret, "pi", "server", msg_type, body, timestamp)

    payload = json.dumps({
        "from": "pi",
        "to": "server",
        "type": msg_type,
        "body": body,
        "timestamp": timestamp,
        "nonce": nonce,
        "signature": signature
    }).encode()

    req = urllib.request.Request(
        f"{server}/messages",
        data=payload,
        headers={
            "Content-Type": "application/json",
            "Authorization": f"Bearer {token}"
        },
        method="POST"
    )
    try:
        with urllib.request.urlopen(req, timeout=15) as resp:
            result = json.loads(resp.read())
            print(json.dumps(result, indent=2))
    except urllib.error.HTTPError as e:
        print(f"ERROR: {e.code} — {e.read().decode()}", file=sys.stderr)
        sys.exit(1)

def read_messages(config):
    secret = get_bridge_secret(config)
    server = config.get("fleet_server", "http://10.66.66.1:8080")
    token = config.get("bridge_token", "MISSING_BRIDGE_TOKEN")

    req = urllib.request.Request(
        f"{server}/messages?for=pi",
        headers={"Authorization": f"Bearer {token}"}
    )
    with urllib.request.urlopen(req, timeout=15) as resp:
        data = json.loads(resp.read())

    messages = data.get("messages", [])
    for msg in messages:
        verified = verify_message(secret, msg)
        msg["_pi_verified"] = verified
        if verified is False:
            msg["_WARNING"] = "SIGNATURE MISMATCH — possible forgery"

    print(json.dumps({"messages": messages, "count": len(messages)}, indent=2))

def ack_message(config, msg_id):
    server = config.get("fleet_server", "http://10.66.66.1:8080")
    token = config.get("bridge_token", "MISSING_BRIDGE_TOKEN")

    payload = json.dumps({"ids": [msg_id]}).encode()
    req = urllib.request.Request(
        f"{server}/messages/ack",
        data=payload,
        headers={
            "Content-Type": "application/json",
            "Authorization": f"Bearer {token}"
        },
        method="POST"
    )
    try:
        with urllib.request.urlopen(req, timeout=15) as resp:
            print(json.loads(resp.read()))
    except urllib.error.HTTPError as e:
        print(f"ERROR: {e.code}", file=sys.stderr)

def ack_all(config):
    server = config.get("fleet_server", "http://10.66.66.1:8080")
    token = config.get("bridge_token", "MISSING_BRIDGE_TOKEN")

    # First get all messages
    req = urllib.request.Request(
        f"{server}/messages?for=pi",
        headers={"Authorization": f"Bearer {token}"}
    )
    with urllib.request.urlopen(req, timeout=15) as resp:
        data = json.loads(resp.read())

    messages = data.get("messages", [])
    ids = [m["id"] for m in messages if m.get("id")]
    if not ids:
        print("No messages to ack")
        return

    # Batch ack all at once
    payload = json.dumps({"ids": ids}).encode()
    req = urllib.request.Request(
        f"{server}/messages/ack",
        data=payload,
        headers={
            "Content-Type": "application/json",
            "Authorization": f"Bearer {token}"
        },
        method="POST"
    )
    try:
        with urllib.request.urlopen(req, timeout=15) as resp:
            result = json.loads(resp.read())
            print(f"Acked {result.get('acked', 0)}/{len(ids)} messages")
    except urllib.error.HTTPError as e:
        print(f"ERROR: {e.code} — {e.read().decode()}", file=sys.stderr)

def main():
    if len(sys.argv) < 2:
        print(__doc__)
        sys.exit(1)

    config = load_config()
    cmd = sys.argv[1]

    if cmd == "send" and len(sys.argv) >= 4:
        send_message(config, sys.argv[2], " ".join(sys.argv[3:]))
    elif cmd == "read":
        read_messages(config)
    elif cmd == "ack" and len(sys.argv) >= 3:
        ack_message(config, sys.argv[2])
    elif cmd == "ack-all":
        ack_all(config)
    else:
        print(__doc__)
        sys.exit(1)

if __name__ == "__main__":
    main()
