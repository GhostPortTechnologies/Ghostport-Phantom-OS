#!/bin/bash
set -euo pipefail
[[ $(id -u) -eq 0 ]] || exec sudo "$0" "$@"
# gp-dns-switch — records arsenal DNS intent and re-applies via gp-dns-upstream.
# Intent is persisted in arsenal.json so it survives mode switches (sticky).
# Usage: gp-dns-switch [on|off|dreadnought|status]
#   on            encrypted DoH (cloudflared) — default for ISP/ZeroTrust
#   off           plaintext public DNS (1.1.1.1/8.8.8.8) — debug
#   dreadnought   local unbound recursive-to-roots (requires gp-dreadnought-install)
#   status        prints intent: on|off|dreadnought

case "${1:-}" in
  --help|-h)
    sed -n '3,10p' "$0" | sed 's/^# \{0,1\}//'
    exit 0 ;;
esac

ARSENAL_FILE="/etc/ghostport/arsenal.json"

read_intent() {
  if [[ -f "$ARSENAL_FILE" ]]; then
    python3 -c "
import json, sys
try:
    a = json.load(open('$ARSENAL_FILE'))
    print(a.get('dnsMode', 'on'))
except Exception:
    print('on')
" 2>/dev/null
  else
    echo "on"
  fi
}

write_intent() {
  local mode="$1"
  mkdir -p "$(dirname "$ARSENAL_FILE")"
  [[ -f "$ARSENAL_FILE" ]] || echo '{}' > "$ARSENAL_FILE"
  python3 - "$mode" <<'PY'
import json, sys, os
path = "/etc/ghostport/arsenal.json"
mode = sys.argv[1]
with open(path) as f:
    a = json.load(f)
a["dnsMode"] = mode
# encryptedDns boolean kept in sync for dashboard back-compat
a["encryptedDns"] = (mode == "on")
tmp = path + ".tmp"
with open(tmp, "w") as f:
    json.dump(a, f, indent=2)
os.replace(tmp, path)
PY
}

verify_resolution() {
  sleep 1
  dig +short +time=3 +tries=1 example.com @127.0.0.1 >/dev/null 2>&1
}

apply_current() {
  # gp-dns-upstream reads current mode + arsenal.json and writes Pi-hole upstream
  /usr/local/bin/gp-dns-upstream >/dev/null 2>&1 || return 1
}

require_unbound() {
  if ! systemctl is-active --quiet unbound 2>/dev/null; then
    echo "fail: unbound not running — run 'sudo gp-dreadnought-install' first" >&2
    exit 2
  fi
}

case "${1:-status}" in
  on)
    write_intent "on"
    apply_current || { echo "fail" >&2; exit 1; }
    verify_resolution && echo "ok" || { echo "fail" >&2; exit 1; }
    ;;
  off)
    write_intent "off"
    apply_current || { echo "fail" >&2; exit 1; }
    verify_resolution && echo "ok" || { echo "fail" >&2; exit 1; }
    ;;
  dreadnought)
    require_unbound
    write_intent "dreadnought"
    apply_current || { echo "fail" >&2; exit 1; }
    verify_resolution && echo "ok" || { echo "fail" >&2; exit 1; }
    ;;
  status)
    read_intent
    ;;
  *)
    echo "Usage: gp-dns-switch [on|off|dreadnought|status]" >&2
    exit 1
    ;;
esac
