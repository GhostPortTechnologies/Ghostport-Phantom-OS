#!/bin/bash
# gp-dns-switch — Toggle Unbound between cleartext and encrypted DNS (cloudflared DoH)
# Usage: gp-dns-switch [on|off|status]

CONF="/etc/unbound/unbound.conf.d/resolvconf_resolvers.conf"

is_encrypted() {
  grep -q '127\.0\.0\.1@5053' "$CONF" 2>/dev/null
}

case "${1:-status}" in
  on)
    cp "$CONF" "${CONF}.bak"
    cat > "$CONF" <<'EOF'
# Encrypted DNS via cloudflared DoH

forward-zone:
	name: "."
	forward-addr: 127.0.0.1@5053
EOF
    systemctl restart unbound
    sleep 1
    if dig +short +time=3 example.com @127.0.0.1 >/dev/null 2>&1; then
      echo "ok"
    else
      cp "${CONF}.bak" "$CONF"
      systemctl restart unbound
      echo "fail"
      exit 1
    fi
    ;;
  off)
    cp "$CONF" "${CONF}.bak"
    cat > "$CONF" <<'EOF'
# Generated by resolvconf

forward-zone:
	name: "."
	forward-addr: 100.100.100.100
	forward-addr: 1.1.1.1
	forward-addr: 8.8.8.8
EOF
    systemctl restart unbound
    sleep 1
    if dig +short +time=3 example.com @127.0.0.1 >/dev/null 2>&1; then
      echo "ok"
    else
      cp "${CONF}.bak" "$CONF"
      systemctl restart unbound
      echo "fail"
      exit 1
    fi
    ;;
  status)
    if is_encrypted; then
      echo "on"
    else
      echo "off"
    fi
    ;;
  *)
    echo "Usage: gp-dns-switch [on|off|status]"
    exit 1
    ;;
esac
