#!/bin/bash
# gp-passcode — View or reset the GhostPort Command Deck passcode
# Usage: gp-passcode [show|reset]

AUTH_FILE="/etc/ghostport/auth.json"

if [ "$(id -u)" -ne 0 ]; then
  echo "Error: must run as root (sudo gp-passcode $1)"
  exit 1
fi

case "${1:-show}" in
  show)
    if [ ! -f "$AUTH_FILE" ]; then
      echo "No passcode configured. Restart ghostport service to generate one."
      exit 1
    fi
    PASSCODE=$(python3 -c "import json; print(json.load(open('$AUTH_FILE'))['passcode'])" 2>/dev/null)
    if [ -z "$PASSCODE" ]; then
      echo "Passcode not found in auth file. Try: sudo gp-passcode reset"
      exit 1
    fi
    echo ""
    echo "  Device Passcode: $PASSCODE"
    echo ""
    ;;
  reset)
    NEW=$(node -e "
      const crypto = require('crypto');
      const fs = require('fs');
      const chars = 'ABCDEFGHJKMNPQRSTUVWXYZ23456789';
      let parts = [];
      for (let p = 0; p < 3; p++) {
        let s = '';
        for (let i = 0; i < 4; i++) s += chars[crypto.randomInt(chars.length)];
        parts.push(s);
      }
      const passcode = 'GP-' + parts.join('-');
      const salt = crypto.randomBytes(32).toString('hex');
      const hash = crypto.scryptSync(passcode, salt, 64).toString('hex');
      fs.writeFileSync('$AUTH_FILE', JSON.stringify({ passcode, hash, salt }, null, 2));
      fs.chmodSync('$AUTH_FILE', 0o600);
      console.log(passcode);
    ")
    systemctl restart ghostport
    echo ""
    echo "  New passcode: $NEW"
    echo "  Service restarted — all sessions invalidated."
    echo ""
    ;;
  *)
    echo "Usage: gp-passcode [show|reset]"
    exit 1
    ;;
esac
