#!/bin/bash
# Switch Pi-hole upstream DNS based on current mode
# Called by gp-mode after profile apply

MODE="${1:-$(cat /etc/ghostport/current-mode 2>/dev/null || echo isp)}"
DNSMASQ_CONF="/etc/dnsmasq.d/10-ghostport-core.conf"
PIHOLE_CONF="/etc/pihole/pihole.toml"

set_dnsmasq_server() {
  local server="$1"
  if [ ! -f "$DNSMASQ_CONF" ]; then
    echo "[DNS] ERROR: $DNSMASQ_CONF not found" >&2
    return 1
  fi
  # Unconditionally write the correct server — don't rely on pattern matching
  if grep -q "^server=" "$DNSMASQ_CONF"; then
    sed -i "s|^server=.*|server=${server}|" "$DNSMASQ_CONF"
  else
    echo "server=${server}" >> "$DNSMASQ_CONF"
  fi
}

set_pihole_upstream() {
  local server="$1"
  if [ ! -f "$PIHOLE_CONF" ]; then
    echo "[DNS] WARN: $PIHOLE_CONF not found, skipping" >&2
    return 0
  fi
  # Replace the entire upstreams array regardless of current value
  sed -i 's|upstreams = \[.*\]|upstreams = ["'"${server}"'"]|' "$PIHOLE_CONF"
}

case "$MODE" in
  doublehop|zhop)
    # Use data plane unbound resolver (DNS inside WireGuard tunnel)
    set_dnsmasq_server "10.66.67.1#53"
    set_pihole_upstream "10.66.67.1#53"
    # Stop cloudflared — not needed in tunnel modes, prevents DNS leak
    if systemctl is-active --quiet cloudflared 2>/dev/null; then
      sudo systemctl stop cloudflared 2>/dev/null || true
      echo "[DNS] Stopped cloudflared (not needed in tunnel mode)"
    fi
    sudo pihole reloaddns 2>/dev/null || true
    echo "[DNS] Upstream switched to data plane unbound (10.66.67.1:53)"
    ;;
  isp|zerotrust)
    # Consult arsenal.json for DNS intent: on (DoH), off (plaintext), dreadnought (unbound recursive).
    # Sticky across mode switches — a one-time choice persists per feedback_warning_is_enough.
    DNS_MODE=$(python3 -c "
import json
try:
    a = json.load(open('/etc/ghostport/arsenal.json'))
    print(a.get('dnsMode', 'on'))
except Exception:
    print('on')
" 2>/dev/null || echo "on")

    case "$DNS_MODE" in
      dreadnought)
        if ! systemctl is-active --quiet unbound 2>/dev/null; then
          echo "[DNS] WARN: dnsMode=dreadnought but unbound not running — falling back to DoH" >&2
          DNS_MODE="on"
        fi
        ;;
    esac

    case "$DNS_MODE" in
      dreadnought)
        set_dnsmasq_server "127.0.0.1#5335"
        set_pihole_upstream "127.0.0.1#5335"
        # Stop cloudflared — Dreadnought bypasses it (queries go to roots directly)
        if systemctl is-active --quiet cloudflared 2>/dev/null; then
          sudo systemctl stop cloudflared 2>/dev/null || true
          echo "[DNS] Stopped cloudflared (Dreadnought active)"
        fi
        echo "[DNS] Upstream switched to Dreadnought (unbound @127.0.0.1:5335)"
        ;;
      off)
        set_dnsmasq_server "1.1.1.1"
        set_pihole_upstream "1.1.1.1"
        echo "[DNS] Upstream switched to plaintext (1.1.1.1) — ENCRYPTION OFF"
        ;;
      on|*)
        set_dnsmasq_server "127.0.0.1#5053"
        set_pihole_upstream "127.0.0.1#5053"
        if ! systemctl is-active --quiet cloudflared 2>/dev/null; then
          sudo systemctl start cloudflared 2>/dev/null || true
          echo "[DNS] Started cloudflared (DoH proxy)"
        fi
        echo "[DNS] Upstream switched to cloudflared (127.0.0.1:5053)"
        ;;
    esac
    sudo pihole reloaddns 2>/dev/null || true
    ;;
  *)
    echo "[DNS] ERROR: Unknown mode '$MODE' — no DNS changes applied" >&2
    exit 1
    ;;
esac
