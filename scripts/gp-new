#!/bin/bash
# gp-new — Provision a new GhostPort device
# Usage: sudo gp-new [--license-key=XXXX-XXXX-XXXX-XXXX] [--auto]
#
# --auto: Skip GP-DA setup, use default admin password (for factory provisioning)
# --license-key: Register with fleet server using this Stripe license key

set -euo pipefail

LICENSE_KEY=""
AUTO_MODE=false
FLEET_SERVER=$(python3 -c "import json;print(json.load(open('/etc/ghostport/fleet-auth.json')).get('fleet_server','http://10.66.66.1:8080'))" 2>/dev/null)
FLEET_TOKEN=$(python3 -c "import json;print(json.load(open('/etc/ghostport/fleet-auth.json')).get('fleet_token',''))" 2>/dev/null)

for arg in "$@"; do
  case "$arg" in
    --license-key=*) LICENSE_KEY="${arg#*=}" ;;
    --auto) AUTO_MODE=true ;;
  esac
done

if [ "$(id -u)" -ne 0 ]; then
  echo "Error: must run as root (sudo gp-new)"
  exit 1
fi

ADMIN_AUTH="/etc/ghostport/admin-auth.json"
AUTH_DIR="/etc/ghostport"
AUTH_FILE="${AUTH_DIR}/auth.json"
PIHOLE_FILE="${AUTH_DIR}/pihole.json"

mkdir -p "$AUTH_DIR"

# ── GP-DA Setup (first run) ──────────────────────────────
if [ ! -f "$ADMIN_AUTH" ]; then
  if [ "$AUTO_MODE" = true ]; then
    # Auto mode: create GP-DA with a random password, print it
    PASS1=$(node -e "
      const crypto = require('crypto');
      const chars = 'ABCDEFGHJKMNPQRSTUVWXYZabcdefghjkmnpqrstuvwxyz23456789!@#';
      let pw = '';
      for (let i = 0; i < 20; i++) pw += chars[crypto.randomInt(chars.length)];
      console.log(pw);
    ")
  else
    echo ""
    echo "  ╔═══════════════════════════════════════════╗"
    echo "  ║   GP-DA — Domain Admin Setup              ║"
    echo "  ╚═══════════════════════════════════════════╝"
    echo ""
    read -s -p "  Create GP-DA password: " PASS1
    echo ""
    read -s -p "  Confirm password: " PASS2
    echo ""

    if [ "$PASS1" != "$PASS2" ]; then
      echo "  Passwords do not match."
      exit 1
    fi

    if [ ${#PASS1} -lt 8 ]; then
      echo "  Password must be at least 8 characters."
      exit 1
    fi
  fi

  node -e "
    const crypto = require('crypto');
    const fs = require('fs');
    const password = process.argv[1];
    const salt = crypto.randomBytes(32).toString('hex');
    const hash = crypto.scryptSync(password, salt, 64).toString('hex');
    fs.writeFileSync('${ADMIN_AUTH}', JSON.stringify({ hash, salt }, null, 2));
    fs.chmodSync('${ADMIN_AUTH}', 0o600);
  " "$PASS1"

  if [ "$AUTO_MODE" = false ]; then
    echo ""
    echo "  GP-DA account created. Run sudo gp-new again to generate a device passcode."
    echo ""
    exit 0
  fi
fi

# ── GP-DA Authentication ─────────────────────────────────
if [ "$AUTO_MODE" = false ]; then
  echo ""
  read -s -p "  GP-DA Password: " INPUT_PASS
  echo ""

  VALID=$(node -e "
    const crypto = require('crypto');
    const fs = require('fs');
    const admin = JSON.parse(fs.readFileSync('${ADMIN_AUTH}', 'utf8'));
    const hash = crypto.scryptSync(process.argv[1], admin.salt, 64).toString('hex');
    console.log(hash === admin.hash ? 'yes' : 'no');
  " "$INPUT_PASS")

  if [ "$VALID" != "yes" ]; then
    echo "  Access denied."
    exit 1
  fi
fi

# ── Generate Device Passcode ─────────────────────────────
PASSCODE=$(node -e "
  const crypto = require('crypto');
  const chars = 'ABCDEFGHJKMNPQRSTUVWXYZ23456789';
  let parts = [];
  for (let p = 0; p < 3; p++) {
    let s = '';
    for (let i = 0; i < 4; i++) s += chars[crypto.randomInt(chars.length)];
    parts.push(s);
  }
  console.log('GP-' + parts.join('-'));
")

node -e "
  const crypto = require('crypto');
  const fs = require('fs');
  const passcode = process.argv[1];
  const salt = crypto.randomBytes(32).toString('hex');
  const hash = crypto.scryptSync(passcode, salt, 64).toString('hex');
  fs.writeFileSync('${AUTH_FILE}', JSON.stringify({ hash, salt }, null, 2));
  fs.chmodSync('${AUTH_FILE}', 0o600);
" "$PASSCODE"

# ── Auto-configure Pi-hole password ──────────────────────
PIHOLE_PW=$(node -e "
  const crypto = require('crypto');
  const chars = 'ABCDEFGHJKMNPQRSTUVWXYZabcdefghjkmnpqrstuvwxyz23456789';
  let pw = '';
  for (let i = 0; i < 24; i++) pw += chars[crypto.randomInt(chars.length)];
  console.log(pw);
")

pihole setpassword "$PIHOLE_PW" > /dev/null 2>&1 || true
jq -n --arg pw "$PIHOLE_PW" '{password: $pw}' > "$PIHOLE_FILE"
chmod 600 "$PIHOLE_FILE"
chown ghostport-admin:ghostport-admin "$PIHOLE_FILE"

# ── Randomize WiFi password ─────────────────────────────
WIFI_PW=$(node -e "
  const crypto = require('crypto');
  const chars = 'ABCDEFGHJKMNPQRSTUVWXYZabcdefghjkmnpqrstuvwxyz23456789';
  let pw = '';
  for (let i = 0; i < 16; i++) pw += chars[crypto.randomInt(chars.length)];
  console.log(pw);
")

HOSTAPD_CONF="/etc/hostapd/hostapd.conf"
if [ -f "$HOSTAPD_CONF" ]; then
  cp "$HOSTAPD_CONF" "${HOSTAPD_CONF}.bak"
  sed -i "s/^ssid=.*/ssid=GhostPort Router/" "$HOSTAPD_CONF"
  sed -i "s/^wpa_passphrase=.*/wpa_passphrase=${WIFI_PW}/" "$HOSTAPD_CONF"
  systemctl restart hostapd 2>/dev/null || true
fi

# ── Fleet Registration ───────────────────────────────────
FLEET_STATUS="not registered (no license key)"
DEVICE_ID=""

if [ -n "$LICENSE_KEY" ]; then
  SERIAL=$(awk '/^Serial/ {print $3}' /proc/cpuinfo)
  HOSTNAME=$(hostname)

  echo "  Registering with fleet server..."

  REG_BODY=$(jq -n --arg ser "$SERIAL" --arg name "$HOSTNAME" --arg lk "$LICENSE_KEY" \
    '{serial: $ser, name: $name, firmware_version: "0.1.0", hardware: "pi5", license_key: $lk}')
  REG=$(curl -s --max-time 15 -X POST "$FLEET_SERVER/fleet/devices/register" \
    -H "Authorization: Bearer $FLEET_TOKEN" \
    -H "Content-Type: application/json" \
    -d "$REG_BODY" 2>/dev/null || echo '{"error":"unreachable"}')

  DEVICE_ID=$(echo "$REG" | node -e "try{const d=JSON.parse(require('fs').readFileSync('/dev/stdin','utf8'));console.log(d.device?.id||'')}catch{console.log('')}" 2>/dev/null)

  if [ -n "$DEVICE_ID" ]; then
    jq -n --arg did "$DEVICE_ID" --arg ser "$SERIAL" --arg lk "$LICENSE_KEY" --arg fs "$FLEET_SERVER" \
      '{device_id: $did, serial: $ser, license_key: $lk, fleet_server: $fs}' > /etc/ghostport/fleet.json
    chmod 600 /etc/ghostport/fleet.json
    FLEET_STATUS="registered (ID: $DEVICE_ID)"
  else
    ERROR=$(echo "$REG" | node -e "try{const d=JSON.parse(require('fs').readFileSync('/dev/stdin','utf8'));console.log(d.error||'unknown')}catch{console.log('parse error')}" 2>/dev/null)
    FLEET_STATUS="registration failed: $ERROR"
  fi
fi

echo ""
echo "  ╔═══════════════════════════════════════════╗"
echo "  ║   DEVICE PASSCODE                         ║"
echo "  ║   ${PASSCODE}                      ║"
echo "  ╚═══════════════════════════════════════════╝"
echo ""
echo "  Pi-hole API: auto-configured"
echo ""
echo "  ╔═══════════════════════════════════════════╗"
echo "  ║   WIFI NETWORK                            ║"
echo "  ║   SSID: GhostPort Router                  ║"
echo "  ║   PASS: ${WIFI_PW}                ║"
echo "  ╚═══════════════════════════════════════════╝"
echo ""
FLEET_LINE=$(printf "%-39s" "$FLEET_STATUS")
echo "  ╔═══════════════════════════════════════════╗"
echo "  ║   FLEET                                   ║"
echo "  ║   ${FLEET_LINE}║"
echo "  ╚═══════════════════════════════════════════╝"
echo ""
echo "  Device is ready to ship."
echo ""
