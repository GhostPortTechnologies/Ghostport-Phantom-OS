#!/usr/bin/env bash
# Applied on boot — restores WAN type and saved mode (no rollback needed)
set -euo pipefail

MODEFILE="/etc/ghostport/current-mode"
WAN_CONF="/etc/ghostport/wan.json"

# ── Restore WiFi WAN if configured ──────────────────────
if [[ -f "$WAN_CONF" ]]; then
  wan_type=$(python3 -c "import json; print(json.load(open('$WAN_CONF')).get('type','ethernet'))" 2>/dev/null || echo "ethernet")
  if [[ "$wan_type" == "wireless" ]]; then
    echo "[ghostport-boot] Restoring WiFi WAN..."
    if ! timeout 30 /usr/local/bin/gp-wan reconnect; then
      echo "[ghostport-boot] WiFi WAN failed — falling back to ethernet"
      /usr/local/bin/gp-wan ethernet || true
    fi
  fi
fi

# ── Apply saved privacy mode ────────────────────────────
MODE=$(cat "$MODEFILE" 2>/dev/null || echo "isp")

# Validate
case "$MODE" in
  isp|zerotrust|doublehop|zhop) ;;
  *) MODE="isp" ;;
esac

echo "[ghostport-boot] Applying saved mode: $MODE"
if ! timeout 30 /usr/local/bin/gp-mode "$MODE" --no-rollback; then
  echo "[ghostport-boot] ERROR: Mode $MODE failed — falling back to ISP"
  /usr/local/bin/gp-mode isp --no-rollback || true
  echo "isp" > /etc/ghostport/current-mode 2>/dev/null || true
  echo "[ghostport-boot] ISP fallback applied"
else
  echo "[ghostport-boot] Mode $MODE applied successfully"
fi
